  "mma_fragments": {
    "MMA.m16n16k16.e4m3.f32": {
      "logical_lanes": 32,
      "opcode": "0x70",
      "type_code": "0xb",
      "subop": "0",
      "a_fragment": {
        "registers_per_lane": 2,
        "base_alignment": 2,
        "packing": "each 32-bit register holds four FP8 values, byte 0 lowest k",
        "mapping": "for logical lane l, row=l>>1, half=l&1, col_base=8*half; R[A+0] bytes hold A[row][col_base+0..3], R[A+1] bytes hold A[row][col_base+4..7]"
      },
      "b_fragment": {
        "registers_per_lane": 2,
        "base_alignment": 2,
        "packing": "each 32-bit register holds four FP8 values",
        "mapping": "for logical lane l, half=l&1, k_base=8*half, b_col=l>>1; R[B+0] bytes hold B[k_base+0..3][b_col], R[B+1] bytes hold B[k_base+4..7][b_col]"
      },
      "c_fragment": {
        "registers_per_lane": 8,
        "base_alignment": 8,
        "packing": "one FP32 accumulator per register",
        "mapping": "for logical lane l, row=l>>1, half=l&1, col_base=8*half; R[C+i] stores C[row][col_base+i] for i=0..7"
      },
      "d_fragment": {
        "registers_per_lane": 8,
        "base_alignment": 8,
        "packing": "one FP32 result per register",
        "mapping": "for logical lane l, row=l>>1, half=l&1, col_base=8*half; R[D+i] stores D[row][col_base+i] for i=0..7"
      },
      "encoding_fields": {
        "dst": "D fragment base GPR, high bits zero, 8-register aligned, <= R248",
        "src1": "A fragment base GPR, high bits zero, even aligned, <= R254",
        "src2_or_imm32[15:0]": "B fragment base GPR, high bits zero, even aligned, <= R254",
        "src3_or_immext[15:0]": "C fragment base GPR, high bits zero, 8-register aligned, <= R248",
        "pred_ctrl.type_code": "0xb",
        "pred_ctrl.ctrl": "subop, 0 for m16n16k16.e4m3.f32"
      },
      "accumulation_order": "for each output element, execute k=0,1,...,15; do not reassociate or tree-reduce"
    }
  },
